{minimum_otp_vsn, "27.0"}.

{erl_opts, [debug_info, warn_unused_import, warnings_as_errors, warn_missing_spec]}.

%% The registries under evaluation.  None of them are listed in
%% workbench.app.src on purpose: a run starts *only* the registry it is
%% testing, so the others cannot interfere.
{deps, [
    {gproc, "1.3.0"},
    %% gproc's distributed (global scope) mode is built on gen_leader.
    {gen_leader, "0.1.0"},
    {syn, "3.4.2"},
    %% Not the hex release: 1.0.8 deletes a key whenever an expiry entry
    %% fires, and this ref adds the check that the entry still matches the
    %% current lease. Without it a renewed lease can be expired by a stale
    %% entry. See the dependency health section of the README.
    {locker, {git, "https://github.com/wooga/locker.git", {ref, "cf92412"}}}
    %% highlander_pg is an Elixir package and is not built by rebar3. See
    %% elixir/mix.exs.
]}.

%% locker's own rebar.config pulls in a test dependency over the git://
%% protocol, which no longer works.  The workbench only needs the library.
{overrides, [{override, locker, [{deps, []}, {plugins, []}]}]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_missing_spec]},
        {deps, [
            {eqwalizer_support,
                {git_subdir, "https://github.com/whatsapp/eqwalizer.git",
                    {branch, "main"}, "eqwalizer_support"}}
        ]}
    ]}
]}.

%% scenario and action are behaviour definitions: the callbacks are called
%% on the implementing module (Module:name()), not through these modules.
{hank, [
    {ignore, [
        %% Not ours: the Elixir side, fetched by mix.
        "elixir/**",
        {"src/scenario.erl", unused_callbacks},
        {"src/action.erl", unused_callbacks}
    ]}
]}.

{project_plugins, [erlfmt, rebar3_hank]}.
{erlfmt, [write, {print_width, 90}]}.

%% The registries are not listed in workbench.app.src, so dialyzer has to be
%% told about them explicitly.
%% No `unknown' warnings: highlander_pg is built by mix, not by rebar3, so
%% dialyzer cannot see the Elixir modules registry_highlander_pg calls.
{dialyzer, [
    {plt_apps, all_deps},
    {plt_extra_apps, [gproc, syn, locker]},
    {warnings, [no_unknown]}
]}.

{xref_checks, [undefined_function_calls, locals_not_used, deprecated_function_calls]}.
%% Same reason: the Elixir side only exists inside the docker image.
{xref_ignores, [registry_highlander_pg, registry_horde, registry_group]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_export_enabled, true}.

{shell, [{apps, [workbench]}]}.
